---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "A catalogue of Claude Monet's paintings made at Vétheuil, 1878–1881 and the 1901 Lavacourt series.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,opsz,wght@0,12..144,400..700;1,12..144,400..700&display=swap"
      rel="stylesheet"
    />
    <title>{title} — Monet at Vétheuil</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --bg: #0a0a0a;
    --bg-raised: #111111;
    --text: #e8e4dc;
    --text-muted: #8a8680;
    --accent: #c8a96e;
    --accent-dim: #a08050;
    --border: #222222;
    --font-serif: 'EB Garamond', Georgia, 'Times New Roman', serif;
    --font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --pad: clamp(1rem, 4vw, 3rem);
  }

  html {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }

  body {
    min-height: 100dvh;
    max-width: 1440px;
    margin: 0 auto;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  img {
    display: block;
    max-width: 100%;
  }

  /* ── PhotoSwipe overrides ── */
  /*
   * Do NOT override .pswp height here. PhotoSwipe measures window.innerHeight
   * at open-time and sizes the image to that value. Setting height: 100dvh
   * via CSS causes a second layout pass that squashes the already-positioned
   * image. Let PhotoSwipe own its own container (position:fixed; height:100%).
   */
  .pswp {
    --pswp-bg: #000;
  }

  /* Caption overlay registered via ui.registerElement */
  .pswp-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.25rem 1.5rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
    color: #f0ede8;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    pointer-events: none;
    z-index: 100;
  }

  /* Site header */
  .site-header {
    padding: 3rem var(--pad) 1.75rem;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }

  .site-title {
    color: var(--text);
    display: inline-block;
  }

  .site-title:hover {
    text-decoration: none;
  }

  .site-title h1 {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 4vw, 3rem);
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  .site-subtitle {
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Site footer */
  .site-footer {
    margin-top: 5rem;
    padding: 2.5rem var(--pad);
    border-top: 1px solid var(--border);
    text-align: center;
    color: var(--text-muted);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
  }
</style>
